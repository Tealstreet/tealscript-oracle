//@version=5
indicator("ns-param-naming-box-local-v5-v59-v1")
setTop(float y) =>
    array<box> box = array.new<box>()
    array.push(box, box.new(0, 5.0, 1, 1.0))
    box.set_top(array.get(box, 0), y)
    float observed = box.get_top(array.get(box, 0))
    box.delete(array.get(box, 0))
    observed
plot(setTop(29.0), "RESULT")
