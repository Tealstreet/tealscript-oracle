//@version=5
indicator("ns-param-naming-box-parameter-renamed-control-v5-v59-v1")
setTop(array<box> items, float y) =>
    box.set_top(array.get(items, 0), y)
    box.get_top(array.get(items, 0))
var box drawing = box.new(0, 5.0, 1, 1.0)
array<box> holders = array.new<box>()
array.push(holders, drawing)
plot(setTop(holders, 29.0), "RESULT")
