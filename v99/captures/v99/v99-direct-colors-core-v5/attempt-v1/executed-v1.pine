indicator("V99 direct colors core v5", overlay=false, precision=16)
f_code(bool value) => na(value) ? -1 : value ? 1 : 0
plot(bar_index, title="INPUT_INDEX", display=display.data_window)
plot(time, title="INPUT_TIME", display=display.data_window)
plot(barstate.isconfirmed ? 1 : 0, title="CHART_CONFIRMED", display=display.data_window)
plot(f_code(color.rgb(33, 66, 99, 12.1) == #214263DE), title="RGB_12P1_EQ_DE", display=display.data_window)
plot(f_code(color.rgb(33, 66, 99, 12.1) == #214263DF), title="RGB_12P1_EQ_DF", display=display.data_window)
