//@version=6
// SPDX-License-Identifier: MIT
indicator("V98 color na-cast v6", overlay=false, precision=16)
f_code(bool value) => value ? 1 : 0
phase = bar_index % 4
cast = color(na)
color typedNa = na
var color retained = color(na)
slot = array.from(cast)
fromArray = array.get(slot, 0)
alternating = phase % 2 == 0 ? cast : #214263DF
prior = alternating[1]
castPrior = cast[1]
expectedPrior = bar_index == 0 ? typedNa : (phase + 3) % 2 == 0 ? cast : #214263DF
filledDefault = nz(cast)
filledReplacement = nz(cast, #214263DF)
gradientCast = color.from_gradient(5, 0, 10, cast, #FF0000)
gradientNa = color.from_gradient(5, 0, 10, na, #FF0000)
plot(bar_index, title="INPUT_INDEX", display=display.data_window)
plot(time, title="INPUT_TIME", display=display.data_window)
plot(barstate.isconfirmed ? 1 : 0, title="CHART_CONFIRMED", display=display.data_window)
plot(phase, title="CASE_ID", display=display.data_window)
plot(f_code(na(alternating)), title="CURRENT_NA", display=display.data_window)
plot(f_code(na(color(na))), title="EXACT_NA_CAST_CODE", display=display.data_window)
plot(na(color(na)) ? 1 : 0, title="EXACT_NA_CAST", display=display.data_window)
plot(f_code(na(typedNa)), title="TYPED_NA_NA", display=display.data_window)
plot(color.r(cast), title="CAST_R", display=display.data_window)
plot(color.g(cast), title="CAST_G", display=display.data_window)
plot(color.b(cast), title="CAST_B", display=display.data_window)
plot(color.t(cast), title="CAST_T", display=display.data_window)
plot(f_code(na(cast)), title="CAST_NA", display=display.data_window)
plot(color.r(retained), title="VAR_R", display=display.data_window)
plot(color.g(retained), title="VAR_G", display=display.data_window)
plot(color.b(retained), title="VAR_B", display=display.data_window)
plot(color.t(retained), title="VAR_T", display=display.data_window)
plot(f_code(na(retained)), title="VAR_NA", display=display.data_window)
plot(color.r(fromArray), title="ARRAY_R", display=display.data_window)
plot(color.g(fromArray), title="ARRAY_G", display=display.data_window)
plot(color.b(fromArray), title="ARRAY_B", display=display.data_window)
plot(color.t(fromArray), title="ARRAY_T", display=display.data_window)
plot(f_code(na(fromArray)), title="ARRAY_NA", display=display.data_window)
plot(color.r(prior), title="HISTORY_R", display=display.data_window)
plot(color.g(prior), title="HISTORY_G", display=display.data_window)
plot(color.b(prior), title="HISTORY_B", display=display.data_window)
plot(color.t(prior), title="HISTORY_T", display=display.data_window)
plot(f_code(na(prior)), title="HISTORY_NA", display=display.data_window)
plot(color.r(castPrior), title="CAST_HISTORY_R", display=display.data_window)
plot(color.g(castPrior), title="CAST_HISTORY_G", display=display.data_window)
plot(color.b(castPrior), title="CAST_HISTORY_B", display=display.data_window)
plot(color.t(castPrior), title="CAST_HISTORY_T", display=display.data_window)
plot(f_code(na(castPrior)), title="CAST_HISTORY_NA", display=display.data_window)
plot(color.r(filledDefault), title="NZ_DEFAULT_R", display=display.data_window)
plot(color.g(filledDefault), title="NZ_DEFAULT_G", display=display.data_window)
plot(color.b(filledDefault), title="NZ_DEFAULT_B", display=display.data_window)
plot(color.t(filledDefault), title="NZ_DEFAULT_T", display=display.data_window)
plot(f_code(na(filledDefault)), title="NZ_DEFAULT_NA", display=display.data_window)
plot(color.r(filledReplacement), title="NZ_REPLACEMENT_R", display=display.data_window)
plot(color.g(filledReplacement), title="NZ_REPLACEMENT_G", display=display.data_window)
plot(color.b(filledReplacement), title="NZ_REPLACEMENT_B", display=display.data_window)
plot(color.t(filledReplacement), title="NZ_REPLACEMENT_T", display=display.data_window)
plot(f_code(na(filledReplacement)), title="NZ_REPLACEMENT_NA", display=display.data_window)
plot(color.r(gradientCast), title="GRAD_CAST_R", display=display.data_window)
plot(color.g(gradientCast), title="GRAD_CAST_G", display=display.data_window)
plot(color.b(gradientCast), title="GRAD_CAST_B", display=display.data_window)
plot(color.t(gradientCast), title="GRAD_CAST_T", display=display.data_window)
plot(f_code(na(gradientCast)), title="GRAD_CAST_NA", display=display.data_window)
plot(color.r(gradientNa), title="GRAD_NA_R", display=display.data_window)
plot(color.g(gradientNa), title="GRAD_NA_G", display=display.data_window)
plot(color.b(gradientNa), title="GRAD_NA_B", display=display.data_window)
plot(color.t(gradientNa), title="GRAD_NA_T", display=display.data_window)
plot(f_code(na(gradientNa)), title="GRAD_NA_NA", display=display.data_window)
plot(f_code(cast == cast), title="CAST_EQ_SELF", display=display.data_window)
plot(f_code(cast == typedNa), title="CAST_EQ_TYPED_NA", display=display.data_window)
plot(f_code(cast == #000000FF), title="CAST_EQ_BLACK0", display=display.data_window)
plot(f_code(cast == #00000000), title="CAST_EQ_BLACK100", display=display.data_window)
plot(f_code(cast == #214263DF), title="CAST_EQ_DF", display=display.data_window)
plot(f_code(retained == cast), title="VAR_EQ_CAST", display=display.data_window)
plot(f_code(fromArray == cast), title="ARRAY_EQ_CAST", display=display.data_window)
plot(f_code(prior == expectedPrior), title="HISTORY_EQ_EXPECTED", display=display.data_window)
plot(f_code(#214263DF == #214263DF), title="EQ_PRESENT_SELF", display=display.data_window)
plot(f_code(#214263DF == #214263E0), title="EQ_PRESENT_DISTINCT", display=display.data_window)

// Proposed discriminator only: NOT captured, never used as expected engine output.
plot(f_code(fromArray == fromArray), title="ARRAY_EQ_SELF", display=display.data_window)
