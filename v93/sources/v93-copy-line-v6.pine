//@version=6
indicator("V93 copy-line v6", overlay=false, precision=8)
a = line.new(bar_index, 1, bar_index + 1, 2)
b = line.copy(a)
copiedY2 = line.get_y2(b)
line.set_xy1(a, bar_index + 2, 7)
line.set_y2(b, 9)
plot(copiedY2, "INITIAL_COPY_Y2", display=display.data_window)
plot(line.get_x1(a) - bar_index, "SOURCE_X1_REL", display=display.data_window)
plot(line.get_y1(a), "SOURCE_Y1", display=display.data_window)
plot(line.get_y2(a), "SOURCE_Y2", display=display.data_window)
plot(line.get_x1(b) - bar_index, "COPY_X1_REL", display=display.data_window)
plot(line.get_y1(b), "COPY_Y1", display=display.data_window)
plot(line.get_y2(b), "COPY_Y2", display=display.data_window)
line.delete(a)
line.delete(b)
plot(bar_index, "INPUT_INDEX", display=display.data_window)
plot(time, "INPUT_TIME", display=display.data_window)
plot(barstate.isconfirmed ? 1 : 0, "CHART_CONFIRMED", display=display.data_window)
