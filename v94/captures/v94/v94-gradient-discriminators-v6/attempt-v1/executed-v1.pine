//@version=6
indicator("V94 gradient-discriminators v6", overlay=false, precision=16)
phase = bar_index % 7
x = phase == 0 ? -1.0 : phase == 1 ? 0.0 : phase == 2 ? 0.25 : phase == 3 ? 0.5 : phase == 4 ? 0.75 : phase == 5 ? 1.0 : 2.0
partialLower = color.rgb(10, 20, 30, 40)
partialUpper = color.rgb(210, 120, 230, 80)
transparentLower = color.rgb(10, 20, 30, 100)
coloredUpper = color.rgb(210, 120, 230, 20)
opaqueLower = color.rgb(10, 20, 30, 0)
opaqueUpper = color.rgb(210, 120, 230, 0)
partial = color.from_gradient(x, 0, 1, partialLower, partialUpper)
transparent = color.from_gradient(x, 0, 1, transparentLower, coloredUpper)
opaque = color.from_gradient(x, 0, 1, opaqueLower, opaqueUpper)
plot(phase, "PHASE", display=display.data_window)
plot(x, "GRADIENT_X", display=display.data_window)
plot(color.r(partial), "PARTIAL_R", display=display.data_window)
plot(color.g(partial), "PARTIAL_G", display=display.data_window)
plot(color.b(partial), "PARTIAL_B", display=display.data_window)
plot(color.t(partial), "PARTIAL_T", display=display.data_window)
plot(na(partial) ? 1 : 0, "PARTIAL_NA", display=display.data_window)
plot(color.r(transparent), "TRANSPARENT_LOWER_R", display=display.data_window)
plot(color.g(transparent), "TRANSPARENT_LOWER_G", display=display.data_window)
plot(color.b(transparent), "TRANSPARENT_LOWER_B", display=display.data_window)
plot(color.t(transparent), "TRANSPARENT_LOWER_T", display=display.data_window)
plot(na(transparent) ? 1 : 0, "TRANSPARENT_LOWER_NA", display=display.data_window)
plot(color.r(opaque), "OPAQUE_R", display=display.data_window)
plot(color.g(opaque), "OPAQUE_G", display=display.data_window)
plot(color.b(opaque), "OPAQUE_B", display=display.data_window)
plot(color.t(opaque), "OPAQUE_T", display=display.data_window)
plot(na(opaque) ? 1 : 0, "OPAQUE_NA", display=display.data_window)
plot(color.r(partialLower), "PARTIAL_LOWER_R", display=display.data_window)
plot(color.g(partialLower), "PARTIAL_LOWER_G", display=display.data_window)
plot(color.b(partialLower), "PARTIAL_LOWER_B", display=display.data_window)
plot(color.t(partialLower), "PARTIAL_LOWER_T", display=display.data_window)
plot(color.r(partialUpper), "PARTIAL_UPPER_R", display=display.data_window)
plot(color.g(partialUpper), "PARTIAL_UPPER_G", display=display.data_window)
plot(color.b(partialUpper), "PARTIAL_UPPER_B", display=display.data_window)
plot(color.t(partialUpper), "PARTIAL_UPPER_T", display=display.data_window)
plot(color.r(transparentLower), "TRANSPARENT_LOWER_INPUT_R", display=display.data_window)
plot(color.g(transparentLower), "TRANSPARENT_LOWER_INPUT_G", display=display.data_window)
plot(color.b(transparentLower), "TRANSPARENT_LOWER_INPUT_B", display=display.data_window)
plot(color.t(transparentLower), "TRANSPARENT_LOWER_INPUT_T", display=display.data_window)
plot(color.r(coloredUpper), "TRANSPARENT_UPPER_INPUT_R", display=display.data_window)
plot(color.g(coloredUpper), "TRANSPARENT_UPPER_INPUT_G", display=display.data_window)
plot(color.b(coloredUpper), "TRANSPARENT_UPPER_INPUT_B", display=display.data_window)
plot(color.t(coloredUpper), "TRANSPARENT_UPPER_INPUT_T", display=display.data_window)
plot(color.r(opaqueLower), "OPAQUE_LOWER_R", display=display.data_window)
plot(color.g(opaqueLower), "OPAQUE_LOWER_G", display=display.data_window)
plot(color.b(opaqueLower), "OPAQUE_LOWER_B", display=display.data_window)
plot(color.t(opaqueLower), "OPAQUE_LOWER_T", display=display.data_window)
plot(color.r(opaqueUpper), "OPAQUE_UPPER_R", display=display.data_window)
plot(color.g(opaqueUpper), "OPAQUE_UPPER_G", display=display.data_window)
plot(color.b(opaqueUpper), "OPAQUE_UPPER_B", display=display.data_window)
plot(color.t(opaqueUpper), "OPAQUE_UPPER_T", display=display.data_window)
plot(bar_index, "INPUT_INDEX", display=display.data_window)
plot(time, "INPUT_TIME", display=display.data_window)
plot(barstate.isconfirmed ? 1 : 0, "CHART_CONFIRMED", display=display.data_window)
