//@version=6
indicator("v95-matrix-mutations-v6", overlay=false, precision=16, max_bars_back=256)
var int firstIndex = bar_index
var int firstTime = time
phase = bar_index % 16
m = matrix.new<float>(2, 3, 1.0)
matrix.fill(m, 9.0, 0, 1, 1, 3)
copy = matrix.copy(m)
sub = matrix.submatrix(m, 0, 2, 1, 3)
matrix.set(sub, 0, 0, 77.0)
pre = matrix.get(m, 0, 1)
matrix.reverse(m)
matrix.swap_rows(m, 0, 1)
matrix.reshape(m, 3, 2)
extra = matrix.new<float>(3, 1, 8.0)
joined = matrix.concat(m, extra)

plot(bar_index, title="INPUT_INDEX")
plot(time, title="INPUT_TIME")
plot(barstate.isconfirmed ? 1 : 0, title="CHART_CONFIRMED")
plot(barstate.isfirst ? 1 : 0, title="IS_FIRST")
plot(firstIndex, title="FIRST_INDEX")
plot(firstTime, title="FIRST_TIME")
plot(phase, title="PHASE")
plot(pre, title="PRE_SUB_SOURCE")
plot(matrix.get(copy, 0, 1), title="COPY_01")
plot(matrix.get(sub, 0, 0), title="SUB_00")
plot(matrix.rows(m), title="ROWS")
plot(matrix.columns(m), title="COLS")
plot(matrix.elements_count(m), title="ELEMENTS")
plot(matrix.rows(joined), title="JOIN_ROWS")
plot(matrix.columns(joined), title="JOIN_COLS")
plot(matrix.elements_count(joined), title="JOIN_ELEMENTS")
plot(matrix.rows(joined) > 0 and matrix.columns(joined) > 0 ? matrix.get(joined, 0, 0) : na, title="JOIN_0_0")
plot(matrix.rows(joined) > 0 and matrix.columns(joined) > 1 ? matrix.get(joined, 0, 1) : na, title="JOIN_0_1")
plot(matrix.rows(joined) > 0 and matrix.columns(joined) > 2 ? matrix.get(joined, 0, 2) : na, title="JOIN_0_2")
plot(matrix.rows(joined) > 1 and matrix.columns(joined) > 0 ? matrix.get(joined, 1, 0) : na, title="JOIN_1_0")
plot(matrix.rows(joined) > 1 and matrix.columns(joined) > 1 ? matrix.get(joined, 1, 1) : na, title="JOIN_1_1")
plot(matrix.rows(joined) > 1 and matrix.columns(joined) > 2 ? matrix.get(joined, 1, 2) : na, title="JOIN_1_2")
plot(matrix.rows(joined) > 2 and matrix.columns(joined) > 0 ? matrix.get(joined, 2, 0) : na, title="JOIN_2_0")
plot(matrix.rows(joined) > 2 and matrix.columns(joined) > 1 ? matrix.get(joined, 2, 1) : na, title="JOIN_2_1")
plot(matrix.rows(joined) > 2 and matrix.columns(joined) > 2 ? matrix.get(joined, 2, 2) : na, title="JOIN_2_2")
