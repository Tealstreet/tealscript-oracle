//@version=6
indicator("v95-input-defaults-v6", overlay=false, precision=16, max_bars_back=256)
var int firstIndex = bar_index
var int firstTime = time
phase = bar_index % 16
enum Mode
    A = "Alpha"
    B = "Beta"
i = input.int(7, "I", minval=1, maxval=9, step=2)
f = input.float(1.25, "F", minval=0.25, maxval=2.25, step=0.5)
b = input.bool(true, "B")
s = input.string("AB1", "S", options=["AB1", "xy2"])
e = input.enum(Mode.A, "E", options=[Mode.A, Mode.B])
sess = input.session("2300-0200", "SESSION")
tf = input.timeframe("6", "TF")
sym = input.symbol("BINANCE:BTCUSDT", "SYMBOL")
src = input.source(close, "SOURCE")
p = input.price(12.5, "PRICE", confirm=false)
t = input.time(timestamp("01 Jan 2026 00:00 +0000"), "TIME", confirm=false)
c = input.color(color.rgb(10, 20, 30, 40), "COLOR")
generic = input(2, "GENERIC")
textValue = input.text_area("AB\n1", "TEXT")

plot(bar_index, title="INPUT_INDEX")
plot(time, title="INPUT_TIME")
plot(barstate.isconfirmed ? 1 : 0, title="CHART_CONFIRMED")
plot(barstate.isfirst ? 1 : 0, title="IS_FIRST")
plot(firstIndex, title="FIRST_INDEX")
plot(firstTime, title="FIRST_TIME")
plot(phase, title="PHASE")
plot(i, title="INT")
plot(f, title="FLOAT")
plot(b ? 1 : 0, title="BOOL")
plot(str.length(s), title="STRING_LENGTH")
plot(s == "AB1" ? 1 : 0, title="STRING_EXACT")
plot(e == Mode.A ? 1 : 0, title="ENUM_A")
plot(str.length(sess), title="SESSION_LENGTH")
plot(sess == "2300-0200" ? 1 : 0, title="SESSION_EXACT")
plot(str.length(tf), title="TF_LENGTH")
plot(tf == "6" ? 1 : 0, title="TF_EXACT")
plot(str.length(sym), title="SYMBOL_LENGTH")
plot(sym == "BINANCE:BTCUSDT" ? 1 : 0, title="SYMBOL_EXACT")
plot(src, title="SOURCE")
plot(close, title="INPUT_CLOSE")
plot(p, title="PRICE")
plot(t, title="TIME")
plot(color.r(c), title="COLOR_R")
plot(color.g(c), title="COLOR_G")
plot(color.b(c), title="COLOR_B")
plot(color.t(c), title="COLOR_T")
plot(generic, title="GENERIC")
plot(str.length(textValue), title="TEXT_LENGTH")
plot(textValue == "AB\n1" ? 1 : 0, title="TEXT_EXACT")
