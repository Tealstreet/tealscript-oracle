//@version=6
indicator("v95-ltf-tuples-v6", overlay=false, precision=16, max_bars_back=256)
var int firstIndex = bar_index
var int firstTime = time
phase = bar_index % 16
[lt, ltc, lo, lh, ll, lc, lv, lx] = request.security_lower_tf(syminfo.tickerid, "1", [time, time_close, open, high, low, close, volume, close * 2.0 + 1.0])
n = array.size(lt)
f_get(array<float> a, int i) => array.size(a) > i ? array.get(a, i) : na
f_time(array<int> a, int i) => array.size(a) > i ? array.get(a, i) : na

plot(bar_index, title="INPUT_INDEX")
plot(time, title="INPUT_TIME")
plot(barstate.isconfirmed ? 1 : 0, title="CHART_CONFIRMED")
plot(barstate.isfirst ? 1 : 0, title="IS_FIRST")
plot(firstIndex, title="FIRST_INDEX")
plot(firstTime, title="FIRST_TIME")
plot(phase, title="PHASE")
plot(n, title="N")
plot(array.size(ltc), title="N_ltc")
plot(array.size(lo), title="N_lo")
plot(array.size(lh), title="N_lh")
plot(array.size(ll), title="N_ll")
plot(array.size(lc), title="N_lc")
plot(array.size(lv), title="N_lv")
plot(array.size(lx), title="N_lx")
plot(f_time(lt, 0), title="LT_0")
plot(f_time(ltc, 0), title="LTC_0")
plot(f_get(lo, 0), title="LO_0")
plot(f_get(lh, 0), title="LH_0")
plot(f_get(ll, 0), title="LL_0")
plot(f_get(lc, 0), title="LC_0")
plot(f_get(lv, 0), title="LV_0")
plot(f_get(lx, 0), title="LX_0")
plot(f_time(lt, 1), title="LT_1")
plot(f_time(ltc, 1), title="LTC_1")
plot(f_get(lo, 1), title="LO_1")
plot(f_get(lh, 1), title="LH_1")
plot(f_get(ll, 1), title="LL_1")
plot(f_get(lc, 1), title="LC_1")
plot(f_get(lv, 1), title="LV_1")
plot(f_get(lx, 1), title="LX_1")
plot(time_close, title="CHART_CLOSE_TIME")
