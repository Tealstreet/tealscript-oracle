    r24 = line.new(bar_index - ((bar_index - 24) % 32), 10, bar_index - ((bar_index - 24) % 32), 90, color=color.red)
    ruler8_delta := line.get_x1(r8) - anchorIndex
    ruler24_delta := line.get_x1(r24) - anchorIndex
phase = bar_index % 32
v = phase < 8 ? 25 : phase < 24 ? 75 : 25
plot(v, "STEP", color=color.blue, linewidth=1, style=plot.style_stepline)
plot(build ? ruler8_delta : na, "RULER8_DELTA", display=display.data_window)
plot(build ? ruler24_delta : na, "RULER24_DELTA", display=display.data_window)
plot(phase, "PHASE32", display=display.data_window)
plot(bar_index, "INPUT_INDEX", display=display.data_window)
