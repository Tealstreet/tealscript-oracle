    b0 = box.new(bar_index - 30, 95, bar_index - 1, 70, bgcolor=color.white, text="EDGE", text_color=color.blue, text_size=size.large, text_halign=text.align_left)
    b1 = box.new(bar_index - 30, 65, bar_index - 1, 40, bgcolor=color.white, text="EDGE", text_color=color.blue, text_size=size.large, text_halign=text.align_center)
    b2 = box.new(bar_index - 30, 35, bar_index - 1, 10, bgcolor=color.white, text="EDGE", text_color=color.blue, text_size=size.large, text_halign=text.align_right)
    box0_span := box.get_right(b0) - box.get_left(b0)
    box1_span := box.get_right(b1) - box.get_left(b1)
    box2_span := box.get_right(b2) - box.get_left(b2)
plot(build ? box0_span : na, "BOX0_SPAN", display=display.data_window)
plot(build ? box1_span : na, "BOX1_SPAN", display=display.data_window)
plot(build ? box2_span : na, "B