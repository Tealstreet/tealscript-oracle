//@version=5
// SPDX-License-Identifier: MIT
indicator("v104-box-wrap-v5", overlay=false, precision=16, max_lines_count=60, max_boxes_count=30, max_labels_count=30)
var int anchorIndex = na
var float box0_span = na
var float box1_span = na
var float box2_span = na
build = barstate.islastconfirmedhistory and na(anchorIndex) and bar_index >= 240
if build
    anchorIndex := bar_index
    b0 = box.new(bar_index - 30, 90, bar_index - 22, 25, bgcolor=color.white, text="ALPHA BETA GAMMA DELTA", text_color=color.blue, text_size=size.large, text_halign=text.align_left, text_valign=text.align_top, text_wrap=text.wrap_auto)
    b1 = box.new(bar_index - 19, 90, bar_index - 11, 25, bgcolor=color.white, text="ALPHA BETA GAMMA DELTA", text_color=color.blue, text_size=size.large, text_halign=text.align_left, text_valign=text.align_top, text_wrap=text.wrap_none)
    b2 = box.new(bar_index