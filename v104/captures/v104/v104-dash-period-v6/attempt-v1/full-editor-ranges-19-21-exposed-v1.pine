r_index - 30, 65, bar_index - 1, 65, color=color.blue, width=4, style=line.style_dashed)
    l2 = line.new(bar_index - 30, 40, bar_index - 1, 40, color=color.blue, width=8, style=line.style_dashed)
    line0_span := line.get_x2(l0) - line.get_x1(l0)
    line1_span := line.get_x2(l1) - line.get_x1(l1)
    line2_span := line.get_x2(l2) - line.get_x1(l2)
plot(build ? line0_span : na, "LINE0_SPAN", display=display.data_window)
plot(build ? line1_span : na, "LINE1_SPAN", display=display.data_window)
plot(build ? line2_span : na, "LINE2_SPAN", display=display.data_window)
plot(bar_index, "INPUT_INDEX", display=display.data_window)
plot(time, "INPUT_TIME", display=display.data_window)
plot(barstate.isconfirmed ? 1 : 0, "CHART_CONFIRMED", display=display.data_window)
plot(bar_index % 8, "CASE_ID", display=display.data_window)
plot(build ? anchorIndex : na, "VISUAL_ANCHOR_INDEX", display=display.data_window)
plot(build ? time : na, "VISUAL_ANCHOR_TIME", display=display.data_window)
plot(0, "SCALE_LOW", color=color.gray)
plot(100, "SCALE_HIGH", color=color.gray)
