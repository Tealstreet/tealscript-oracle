//@version=6
// SPDX-License-Identifier: MIT
indicator("v104-arrow-direction-v6", overlay=true, precision=16, max_lines_count=60, max_boxes_count=30, max_labels_count=30)
var int anchorIndex = na
build = barstate.islastconfirmedhistory and na(anchorIndex) and bar_index >= 240
if build
    anchorIndex := bar_index
phase = bar_index % 32
v = phase == 8 ? 1 : phase == 24 ? -1 : na
plotarrow(v, "DIRECTION", colorup=color.blue, colordown=color.orange, minheight=48, maxheight=48)
plot(v, "SIGN", display=display.data_window)
controlSign = phase == 12 ? 1 : phase == 28 ? -1 : na
plot(controlSign, "CONTROL_SIGN", display=display.data_window)
plotchar(phase == 12, "UP_CONTROL", char="U", location=location.abovebar, color=color.blue)
plotchar(phase == 28, "DOWN_CONTROL", char="D", location=location.belowbar, color=color.orange)

plot(bar_index, "INPUT_INDEX", display=display.data_window)
plot(time, "INPUT_TIME", display=display.data_window)
plot(barstate.isconfirmed ? 1 : 0, 