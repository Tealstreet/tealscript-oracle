//@version=5
// SPDX-License-Identifier: MIT
indicator("V102 line-price-vertical v5", overlay=false, precision=16, max_lines_count=80, max_boxes_count=40, max_labels_count=40, max_polylines_count=20)
phase = bar_index % 8
keep = barstate.islastconfirmedhistory and bar_index >= 200
a = line.new(bar_index - 10, 20, bar_index - 10, 40)
before = 1
vertical = line.get_price(a, bar_index - 10)
verticalNa = na(vertical) ? 1 : 0
line.delete(a)

plot(before, "REACHED_BEFORE", display=display.data_window)
plot(vertical, "VERTICAL_PRICE", display=display.data_window)
plot(verticalNa, "VERTICAL_NA", display=display.data_window)
plot(bar_index, "INPUT_INDEX", display=display.data_window)
plot(time, "INPUT_TIME", display=display.data_window)
plot(barstate.isconfirmed ? 1 : 0, "CHART_CONFIRMED", display=display.data_window)
plot(phase, "CASE_ID", display=display.data_window)
plot(barstate.islastconfirmedhistory ? time : na, "VISUAL_ANCHOR_TIME", display=display.data_window)
plot(barstate.islastconfirmedhistory ? bar_index : na, "VISUAL_ANCHOR_INDEX", display=display.data_window)
plot(0, "SCALE_ZERO", color=color.gray)
plot(100, "SCALE_HUNDRED", color=color.gray)
