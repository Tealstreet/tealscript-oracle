//@version=6
// SPDX-License-Identifier: MIT
indicator("V102 table-relocation v6", overlay=false, precision=16, max_lines_count=80, max_boxes_count=40, max_labels_count=40, max_polylines_count=20)
phase = bar_index % 8
keep = barstate.islastconfirmedhistory and bar_index >= 200
base = array.size(table.all)
a = table.new(position.top_left, 2, 2, bgcolor=color.aqua)
b = table.new(position.middle_center, 2, 2)
c = table.new(position.bottom_left, 2, 2, bgcolor=color.yellow, frame_color=color.blue, frame_width=5, border_color=color.red, border_width=3)
for col = 0 to 1
    for row = 0 to 1
        table.cell(a, col, row, "A", width=0, height=0, text_color=color.black)
        table.cell(b, col, row, row == 0 ? "B TOP" : "B END", width=0, height=0, text_color=color.black)
        table.cell(c, col, row, row == 0 ? "C TOP" : "C END", text_color=color.black)
table.merge_cells(b, 0, 0, 1, 0)
table.merge_cells(c, 0, 0, 1, 0)
created = array.size(table.all) - base
table.set_position(b, position.top_left)
collision = array.size(table.all) - base
oldNa = na(a) ? 1 : 0
table.set_position(b, position.bottom_right)
table.set_bgcolor(b, color.yellow)
table.set_frame_color(b, color.blue)
table.set_frame_width(b, 5)
table.set_border_color(b, color.red)
table.set_border_width(b, 3)
finalCount = array.size(table.all) - base
if not keep
    table.delete(a)
    table.delete(b)
    table.delete(c)

plot(created, "CREATED_DELTA", display=display.data_window)
plot(collision, "COLLISION_DELTA", display=display.data_window)
plot(oldNa, "OLD_TABLE_NA", display=display.data_window)
plot(finalCount, "FINAL_DELTA", display=display.data_window)
plot(9, "FINAL_POSITION_INTENT", display=display.data_window)
plot(bar_index, "INPUT_INDEX", display=display.data_window)
plot(time, "INPUT_TIME", display=display.data_window)
plot(barstate.isconfirmed ? 1 : 0, "CHART_CONFIRMED", display=display.data_window)
plot(phase, "CASE_ID", display=display.data_window)
plot(barstate.islastconfirmedhistory ? time : na, "VISUAL_ANCHOR_TIME", display=display.data_window)
plot(barstate.islastconfirmedhistory ? bar_index : na, "VISUAL_ANCHOR_INDEX", display=display.data_window)
plot(0, "SCALE_ZERO", color=color.gray)
plot(100, "SCALE_HUNDRED", color=color.gray)
