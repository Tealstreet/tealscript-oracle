t_color=color.blue, text_size=18, text_font_family=font.family_monospace, text_halign=text.align_left, text_valign=text.align_top)
    box.set_text_formatting(c, text.format_italic)
    d = box.new(bar_index -45, 45, bar_index -5, 15, bgcolor=color.white, border_color=color.blue, text="FORMAT", text_color=color.blue, text_size=18, text_font_family=font.family_monospace, text_halign=text.align_left, text_valign=text.align_top)
    box.set_text_formatting(d, text.format_bold + text.format_italic)

plot(bar_index, "INPUT_INDEX", display=display.data_window)
plot(time, "INPUT_TIME", display=display.data_window)
plot(barstate.isconfirmed ? 1 : 0, "CHART_CONFIRMED", display=display.data_window)
plot(phase, "CASE_ID", display=display.data_window)
plot(build ? anchorIndex : na, "VISUAL_ANCHOR_INDEX", display=display.data_window)
plot(build ? anchorTime : na, "VISUAL_ANCHOR_TIME", display=display.data_window)
plot(0, "SCALE_LOW", color=color.gray)
plot(100, "SCALE_HIGH", color=color.gray)
