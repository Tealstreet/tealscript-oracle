    line.set_y2(b, 50)
    c = line.new(bar_index - 40, 30, bar_index - 5, 30, color=color.gray)
    d = line.new(bar_index - 40, 50, bar_index - 5, 50, color=color.gray)
    h = linefill.new(c, d, color.new(color.red, 50))
    j = linefill.new(c, d, color.new(color.green, 50))
    linefill.delete(h)
    COUNT := array.size(linefill.all)
    PARENT_A := line.get_y1(linefill.get_line1(g))
    PARENT_B := line.get_y1(linefill.get_line2(g))

plot(build ? COUNT : na, "COUNT", display=display.data_window)
plot(build ? PARENT_A : na, "PARENT_A", display=display.data_window)
plot(build ? PARENT_B : na, "PARENT_B", display=display.data_window)
plot(bar_index, "INPUT_INDEX", display=display.data_window)
plot(time, "INPUT_TIME", display=display.data_window)
plot(barstate.isconfirmed ? 1 : 0, "CHART_CONFIRMED", display=display.data_window)
plot(phase, "CASE_ID", display=display.data_window)
plot(build ? anchorIndex : na, "VISUAL_ANCHOR_INDE