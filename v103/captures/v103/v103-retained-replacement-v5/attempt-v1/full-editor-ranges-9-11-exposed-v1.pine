//@version=5
// SPDX-License-Identifier: MIT
indicator("V103 retained-replacement v5", overlay=false, precision=16, max_lines_count=100, max_boxes_count=60, max_labels_count=60, max_polylines_count=30)
phase = bar_index % 8
var int anchorIndex = na
var int anchorTime = na
build = barstate.islastconfirmedhistory and na(anchorIndex) and bar_index >= 240
var float COUNT = na
var float PARENT_A = na
var float PARENT_B = na
if build
    anchorIndex := bar_index
    anchorTime := time
    a = line.new(bar_index - 90, 60, bar_index - 55, 60, color=color.gray)
    b = line.new(bar_index - 90, 80, bar_index - 55, 80, color=color.gray)
    f = linefill.new(a, b, color.new(color.red, 50))
    g = linefill.new(a, b, color.new(color.blue, 50))
    line.set_y1(a, 30)
    line.set_y2(a, 30)
    line.set_y1(b, 50)
