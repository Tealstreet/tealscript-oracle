indicator("V103 polyline-fill-style v6", overlay=false, precision=16, max_lines_count=100, max_boxes_count=60, max_labels_count=60, max_polylines_count=30)
phase = bar_index % 8
var int anchorIndex = na
var int anchorTime = na
build = barstate.islastconfirmedhistory and na(anchorIndex) and bar_index >= 240
var float COUNT = na
if build
    anchorIndex := bar_index
    anchorTime := time
    p = chart.point.from_index(bar_index - 95, 20)
    q = chart.point.from_index(bar_index - 75, 85)
    r = chart.point.from_index(bar_index - 55, 20)
    pts = array.from(p, q, r)
    a = polyline.new(pts, curved=false, closed=true, line_color=color.blue, fill_color=color.new(color.orange, 20), line_style=line.style_dashed, line_width=4)
    q.price := 40
    control = array.from(chart.point.from_index(bar_index - 45, 20), chart.point.from_index(bar_index - 25, 85), cha