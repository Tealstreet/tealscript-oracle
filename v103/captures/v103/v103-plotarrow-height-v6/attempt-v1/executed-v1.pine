//@version=6
// SPDX-License-Identifier: MIT
indicator("V103 plotarrow-height v6", overlay=true, precision=16, max_lines_count=100, max_boxes_count=60, max_labels_count=60, max_polylines_count=30)
phase = bar_index % 8
var int anchorIndex = na
var int anchorTime = na
build = barstate.islastconfirmedhistory and na(anchorIndex) and bar_index >= 240
if build
    anchorIndex := bar_index
    anchorTime := time

arrowPhase = bar_index % 32
v = arrowPhase == 0 ? 1 : arrowPhase == 8 ? 2 : arrowPhase == 16 ? 4 : arrowPhase == 24 ? -4 : na
plot(arrowPhase, "ARROW_PHASE", display=display.data_window)
plotarrow(v, "ARROWS", colorup=color.blue, colordown=color.orange, minheight=8, maxheight=24)
plot(bar_index, "INPUT_INDEX", display=display.data_window)
plot(time, "INPUT_TIME", display=display.data_window)
plot(barstate.isconfirmed ? 1 : 0, "CHART_CONFIRMED", display=display.data_window)
plot(phase, "CASE_ID", display=display.data_window)
plot(build ? anchorIndex : na, "VISUAL_ANCHOR_INDEX", display=display.data_window)
plot(build ? anchorTime : na, "VISUAL_ANCHOR_TIME", display=display.data_window)
plot(0, "SCALE_LOW", color=color.gray, display=display.data_window)
plot(100, "SCALE_HIGH", color=color.gray, display=display.data_window)
