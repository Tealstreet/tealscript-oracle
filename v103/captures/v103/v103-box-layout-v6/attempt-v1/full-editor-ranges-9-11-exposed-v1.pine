indicator("V103 box-layout v6", overlay=false, precision=16, max_lines_count=100, max_boxes_count=60, max_labels_count=60, max_polylines_count=30)
phase = bar_index % 8
var int anchorIndex = na
var int anchorTime = na
build = barstate.islastconfirmedhistory and na(anchorIndex) and bar_index >= 240
if build
    anchorIndex := bar_index
    anchorTime := time
    a = box.new(bar_index - 95, 95, bar_index - 87, 50, bgcolor=color.white, border_color=color.blue, text="AA BB CC DD EE FF", text_color=color.blue, text_size=12, text_font_family=font.family_monospace, text_halign=text.align_left, text_valign=text.align_top, text_wrap=text.wrap_none)
    box.set_text_wrap(a, text.wrap_auto)
    b = box.new(bar_index - 35, 95, bar_index - 27, 50, bgcolor=color.white, border_color=color.blue, text="AA BB CC DD EE FF", text_color=color.blue, text_size=12, text_f