if build
    anchorIndex := bar_index
    anchorTime := time
    a = line.new(bar_index - 90, 60, bar_index - 55, 60, color=color.gray)
    b = line.new(bar_index - 90, 80, bar_index - 55, 80, color=color.gray)
    f = linefill.new(a, b, color.new(color.red, 50))
    g = linefill.new(a, b, color.new(color.blue, 50))
    line.set_y1(a, 30)
    line.set_y2(a, 30)
    line.set_y1(b, 50)
    line.set_y2(b, 50)
    c = line.new(bar_index - 40, 30, bar_index - 5, 30, color=color.gray)
    d = line.new(bar_index - 40, 50, bar_index - 5, 50, color=color.gray)
    h = linefill.new(c, d, color.new(color.red, 50))
    j = linefill.new(c, d, color.new(color.green, 50))
    linefill.delete(h)
    COUNT := array.size(linefill.all)
    PARENT_A := line.get_y1(linefill.get_line1(g))
    PARENT_B := line.get_y1(linefill.get_line2(g))

