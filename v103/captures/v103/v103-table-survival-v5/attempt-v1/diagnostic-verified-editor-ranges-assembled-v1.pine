//@version=5
// SPDX-License-Identifier: MIT
indicator("V103 table-survival v5", overlay=false, precision=16, max_lines_count=100, max_boxes_count=60, max_labels_count=60, max_polylines_count=30)
phase = bar_index % 8
var int anchorIndex = na
var int anchorTime = na
build = barstate.islastconfirmedhistory and na(anchorIndex) and bar_index >= 240
var float OLD_NA = na
var float COUNT = na
if build
    anchorIndex := bar_index
    anchorTime := time
    a = table.new(position.top_left, 1, 1, bgcolor=color.red)
    table.cell(a, 0, 0, "A OLD", width=20, height=14, text_color=color.white)
    b = table.new(position.middle_center, 2, 2)
    for c = 0 to 1
        table.cell(b, c, 0, "B TOP", width=12, height=12, text_color=color.black)
        table.cell(b, c, 1, c == 0 ? "B LEFT" : "B RIGHT", width=12, height=12, text_color=color.black)
    table.merge_cells(b, 0, 0, 1, 0)
    table.set_position(b, position.top_left)
    OLD_NA := na(a) ? 1 : 0
    table.set_position(b, position.bottom_right)
    table.set_bgcolor(b, color.yellow)
    table.set_frame_color(b, color.blue)
    table.set_frame_width(b, 4)
    table.set_border_color(b, color.red)
    table.set_border_width(b, 2)
    c = table.new(position.bottom_left, 2, 2, bgcolor=color.yellow, frame_color=color.blue, frame_width=4, border_color=color.red, border_width=2)
    for k = 0 to 1
        table.cell(c, k, 0, "C TOP", width=12, height=12, text_color=color.black)
        table.cell(c, k, 1, k == 0 ? "C LEFT" : "C RIGHT", width=12, height=12, text_color=color.black)
    table.merge_cells(c, 0, 0, 1, 0)
    COUNT := array.size(table.all)

plot(build ? OLD_NA : na, "OLD_NA", display=display.data_window)
plot(build ? COUNT : na, "COUNT", display=display.data_window)
plot(bar_index, "INPUT_INDEX", display=display.data_window)
plot(time, "INPUT_TIME", display=display.data_window)
plot(barstate.isconfirmed ? 1 : 0, "CHART_CONFIRMED", display=display.data_window)
plot(phase, "CASE_ID", display=display.data_window)
plot(build ? anchorIndex : na, "VISUAL_ANCHOR_INDEX", display=display.data_window)
plot(build ? anchorTime : na, "VISUAL_ANCHOR_TIME", display=display.data_window)
plot(0, "SCALE_LOW", color=color.gray)
plot(100, "SCALE_HIGH", color=color.gray)
