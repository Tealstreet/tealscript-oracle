    q = chart.point.from_index(bar_index - 75, 85)
    line.set_first_point(a, p)
    line.set_second_point(a, q)
    p.index := bar_index - 10
    p.price := 10
    q.index := bar_index - 5
    q.price := 15
    b = box.new(bar_index - 70, 30, bar_index - 60, 10, bgcolor=color.yellow, border_color=color.blue)
    bp = chart.point.from_index(bar_index - 65, 85)
    bq = chart.point.from_index(bar_index - 50, 65)
    box.set_top_left_point(b, bp)
    box.set_bottom_right_point(b, bq)
    bp.index := bar_index - 15
    bp.price := 40
    bq.index := bar_index - 5
    bq.price := 30
    c = label.new(bar_index - 35, 20, "POINT", style=label.style_label_center, color=color.blue)
    cp = chart.point.from_index(bar_index - 25, 80)
    label.set_point(c, cp)
    cp.index := bar_index - 5
