//@version=6
// SPDX-License-Identifier: MIT
indicator("V103 noncoincident-points v6", overlay=false, precision=16, max_lines_count=100, max_boxes_count=60, max_labels_count=60, max_polylines_count=30)
phase = bar_index % 8
var int anchorIndex = na
var int anchorTime = na
build = barstate.islastconfirmedhistory and na(anchorIndex) and bar_index >= 240
var float TIME_DELTA = na
var float ROUNDTRIP_X = na
var float LINE_X = na
var float LINE_Y = na
var float BOX_LEFT = na
var float BOX_TOP = na
var float LABEL_X = na
var float LABEL_Y = na
if build
    anchorIndex := bar_index
    anchorTime := time
    a = line.new(bar_index - 95, 15, bar_index - 85, 25, color=color.blue, width=4)
    p = chart.point.from_index(bar_index - 85, 75)
