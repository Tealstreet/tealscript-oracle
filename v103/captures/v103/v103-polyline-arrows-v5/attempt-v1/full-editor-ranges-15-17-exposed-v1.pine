    anchorTime := time
    pts_arrow_left = array.from(chart.point.from_index(bar_index - 85, 20), chart.point.from_index(bar_index - 50, 25), chart.point.from_index(bar_index - 15, 20))
    polyline.new(pts_arrow_left, curved=false, closed=false, line_color=color.blue, line_style=line.style_arrow_left, line_width=4)
    pts_arrow_right = array.from(chart.point.from_index(bar_index - 85, 50), chart.point.from_index(bar_index - 50, 55), chart.point.from_index(bar_index - 15, 50))
    polyline.new(pts_arrow_right, curved=false, closed=false, line_color=color.blue, line_style=line.style_arrow_right, line_width=4)
    pts_arrow_both = array.from(chart.point.from_index(bar_index - 85, 80), chart.point.from_index(bar_index - 50, 85), chart.point.from_index(bar_index - 15, 80))
    polyline.new(pts_arrow_both, curved=false, closed=false, line_color=color.blue, line_style=line.style_arrow_both, line_width=4)
    COUNT := array.size(polyline.all)

plot(4, "WIDTH_INTENT", display=display.data_window)
