    box.set_text_color(x, color.red)
    box.set_left(y, bar_index - 60)
    box.set_right(y, bar_index - 45)
    box.set_text(y, "COPY")
    box.new(bar_index - 30, 50, bar_index - 15, 30, text="COPY", text_color=color.blue, bgcolor=color.yellow, border_color=color.blue, border_width=4)
    la = label.new(bar_index - 82, 12, "OLD", style=label.style_label_center, color=color.blue, textcolor=color.white, size=size.normal)
    lb = label.copy(la)
    label.set_text(la, "SRC")
    label.set_color(la, color.red)
    label.set_style(la, label.style_square)
