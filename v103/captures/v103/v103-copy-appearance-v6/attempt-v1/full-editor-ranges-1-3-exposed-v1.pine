indicator("V103 copy-appearance v6", overlay=false, precision=16, max_lines_count=100, max_boxes_count=60, max_labels_count=60, max_polylines_count=30)
phase = bar_index % 8
var int anchorIndex = na
var int anchorTime = na
build = barstate.islastconfirmedhistory and na(anchorIndex) and bar_index >= 240
var float LINE_SOURCE_X = na
var float LINE_COPY_X = na
var float LABEL_COPY_EXACT = na
