    box.set_text_color(x, color.red)
    box.set_left(y, bar_index - 60)
    box.set_right(y, bar_index - 45)
    box.set_text(y, "COPY")
    box.new(bar_index - 30, 50, bar_index - 15, 30, text="COPY", text_color=color.blue, bgcolor=color.yellow, border_color=color.blue, border_width=4)
    la = label.new(bar_index - 82, 12, "OLD", style=label.style_label_center, color=color.blue, textcolor=color.white, size=size.normal)
    lb = label.copy(la)
    label.set_text(la, "SRC")
    label.set_color(la, color.red)
    label.set_style(la, label.style_square)
    label.set_x(lb, bar_index - 52)
    label.set_text(lb, "COPY")
    label.new(bar_index - 22, 12, "COPY", style=label.style_label_center, color=color.blue, textcolor=color.white, size=size.normal)
    LINE_SOURCE_X := line.get_x1(a) - bar_index
    LINE_COPY_X := line.get_x1(b) - bar_index
    LABEL_COPY_EXACT := label.get_text(lb) == "COPY" ? 1 : 0

plot(build ? LINE_SOURCE_X : na, "LINE_SOURCE_X", display=display.data_window)
plot(build ? LINE_COPY_X : na, "LINE_COPY_X", display=display.dat