    label.set_x(lb, bar_index - 52)
    label.set_text(lb, "COPY")
    label.new(bar_index - 22, 12, "COPY", style=label.style_label_center, color=color.blue, textcolor=color.white, size=size.normal)
    LINE_SOURCE_X := line.get_x1(a) - bar_index
    LINE_COPY_X := line.get_x1(b) - bar_index
    LABEL_COPY_EXACT := label.get_text(lb) == "COPY" ? 1 : 0

plot(build ? LINE_SOURCE_X : na, "LINE_SOURCE_X", display=display.data_window)
plot(build ? LINE_COPY_X : na, "LINE_COPY_X", display=display.data_window)
plot(build ? LABEL_COPY_EXACT : na, "LABEL_COPY_EXACT", display=display.data_window)
