    b2 = box.new(bar_index - 25, 68, bar_index - 10, 64, bgcolor=color.new(color.blue, 75), border_color=color.blue)
    box.set_extend(b2, extend.right)
    box.set_border_style(b2, line.style_solid)
    box.set_border_width(b2, 3)
    a3 = line.new(bar_index - 75, 81, bar_index - 35, 81, color=color.red, width=1)
    line.set_extend(a3, extend.both)
    line.set_style(a3, line.style_solid)
    line.set_width(a3, 4)
    b3 = box.new(bar_index - 25, 90, bar_index - 10, 86, bgcolor=color.new(color.blue, 75), border_color=color.blue)
    box.set_extend(b3, extend.both)
    box.set_border_style(b3, line.style_dashed)
    box.set_border_width(b3, 3)

plot(bar_index, "INPUT_INDEX", display=display.data_window)
plot(time, "INPUT_TIME", display=display.data_window)
plot(barstate.isconfirmed ? 1 : 0, "CHART_CONFIRMED", display=display.data_window)
plot(phase, "CASE_ID", display=display.data_window)
plot(build ? anchorIndex : na, "VISUAL_ANCHOR_INDEX", display=display.data_window)
plot(build ? anchorTime : na, "VISUAL_ANCHOR_TIME", display=display.data_window)
plot(0