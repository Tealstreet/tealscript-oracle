_monospace, text_halign=text.align_left, text_valign=text.align_top)
    d = box.new(bar_index - 95, 25, bar_index - 55, 5, bgcolor=color.white, border_color=color.red, text="EDGE", text_color=color.red, text_size=size.normal, text_halign=text.align_left, text_valign=text.align_top)
    e = box.new(bar_index - 45, 25, bar_index - 5, 5, bgcolor=color.white, border_color=color.blue, text="EDGE", text_color=color.blue, text_size=size.normal, text_halign=text.align_left, text_valign=text.align_top)
    box.set_text_halign(e, text.align_right)
    box.set_text_valign(e, text.align_bottom)

plot(bar_index, "INPUT_INDEX", display=display.data_window)
