dex - 95, 25, bar_index - 55, 5, bgcolor=color.white, border_color=color.red, text="EDGE", text_color=color.red, text_size=size.normal, text_halign=text.align_left, text_valign=text.align_top)
    e = box.new(bar_index - 45, 25, bar_index - 5, 5, bgcolor=color.white, border_color=color.blue, text="EDGE", text_color=color.blue, text_size=size.normal, text_halign=text.align_left, text_valign=text.align_top)
    box.set_text_halign(e, text.align_right)
    box.set_text_valign(e, text.align_bottom)

plot(bar_index, "INPUT_INDEX", display=display.data_window)
plot(time, "INPUT_TIME", display=display.data_window)
plot(barstate.isconfirmed ? 1 : 0, "CHART_CONFIRMED", display=display.data_window)
plot(phase, "CASE_ID", display=display.data_window)
plot(build ? anchorIndex : na, "VISUAL_ANCHOR_INDEX", display=display.data_window)
plot(build ? anchorTime : na, "VISUAL_ANCHOR_TIME", display=display.data_window)
plot(0, "SCALE_LOW", color=color.gray)
plot(100, "SCALE_HIGH", color=color.gray)
