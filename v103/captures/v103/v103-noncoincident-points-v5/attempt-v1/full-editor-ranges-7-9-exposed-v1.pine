indicator("V103 noncoincident-points v5", overlay=false, precision=16, max_lines_count=100, max_boxes_count=60, max_labels_count=60, max_polylines_count=30)
phase = bar_index % 8
var int anchorIndex = na
var int anchorTime = na
build = barstate.islastconfirmedhistory and na(anchorIndex) and bar_index >= 240
var float TIME_DELTA = na
var float ROUNDTRIP_X = na
var float LINE_X = na
