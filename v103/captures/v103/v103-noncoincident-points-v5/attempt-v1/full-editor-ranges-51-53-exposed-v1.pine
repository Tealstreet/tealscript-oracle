    LABEL_X := label.get_x(c) - bar_index
    LABEL_Y := label.get_y(c)

plot(build ? TIME_DELTA : na, "TIME_DELTA", display=display.data_window)
plot(build ? ROUNDTRIP_X : na, "ROUNDTRIP_X", display=display.data_window)
plot(build ? LINE_X : na, "LINE_X", display=display.data_window)
plot(build ? LINE_Y : na, "LINE_Y", display=display.data_window)
plot(build ? BOX_LEFT : na, "BOX_LEFT", display=display.data_window)
plot(build ? BOX_TOP : na, "BOX_TOP", display=display.data_window)
plot(build ? LABEL_X : na, "LABEL_X", display=display.data_window)
