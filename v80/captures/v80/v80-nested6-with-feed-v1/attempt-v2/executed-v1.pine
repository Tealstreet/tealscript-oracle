//@version=6
indicator("Namespace methods", precision=16)
import sours-lat/R2Nsad4a19ecf824/1 as lib
outer(value) => request.security("BINANCE:BTCUSDT", "1D", request.security("BINANCE:BTCUSDT", "1D", lib.pick(value) + lib.pick(int(7)), lookahead=barmerge.lookahead_on), lookahead=barmerge.lookahead_on)
plot(outer(close))
plot(request.security("BINANCE:BTCUSDT", "1D", close, lookahead=barmerge.lookahead_on), title="REQUESTED_CLOSE_CONTROL")

[dTime, dTimeClose, dOpen, dHigh, dLow, dClose, dVolume] = request.security("BINANCE:BTCUSDT", "1D", [time, time_close, open, high, low, close, volume], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
plot(dTime, title="D_TIME")
plot(dTimeClose, title="D_TIME_CLOSE")
plot(dOpen, title="D_OPEN")
plot(dHigh, title="D_HIGH")
plot(dLow, title="D_LOW")
plot(dClose, title="D_CLOSE")
plot(dVolume, title="D_VOLUME")
[nTime, nTimeClose, nOpen, nHigh, nLow, nClose, nVolume] = request.security("BINANCE:BTCUSDT", "1D", request.security("BINANCE:BTCUSDT", "1D", [time, time_close, open, high, low, close, volume], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
plot(nTime, title="N_TIME")
plot(nTimeClose, title="N_TIME_CLOSE")
plot(nOpen, title="N_OPEN")
plot(nHigh, title="N_HIGH")
plot(nLow, title="N_LOW")
plot(nClose, title="N_CLOSE")
plot(nVolume, title="N_VOLUME")
plot(time, title="CHART_TIME")
plot(time_close, title="CHART_TIME_CLOSE")
plot(open, title="CHART_OPEN")
plot(high, title="CHART_HIGH")
plot(low, title="CHART_LOW")
plot(close, title="CHART_CLOSE")
plot(volume, title="CHART_VOLUME")
plot(barstate.isconfirmed ? 1 : 0, title="CHART_CONFIRMED")
plot(timenow, title="CAPTURE_CLOCK_MS")
